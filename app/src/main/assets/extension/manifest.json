{
  "name": "NopeCHA: CAPTCHA Solver",
  "version": "0.6.1",
  "description": "AI Solver for reCAPTCHA, hCAPTCHA, and all CAPTCHA.",
  "permissions": [
    "scripting",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.hcaptcha.com/captcha/*"
      ],
      "js": [
        "assets/3j6q82.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.google.com/recaptcha/*",
        "*://*.recaptcha.net/recaptcha/*"
      ],
      "js": [
        "assets/3zhiwh.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.arkoselabs.com/fc/*",
        "*://*.funcaptcha.com/fc/*",
        "*://*/fc/assets/*"
      ],
      "js": [
        "assets/pz2lyx.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://challenges.cloudflare.com/cdn-cgi/challenge-platform/*",
        "*://challenges.fed.cloudflare.com/cdn-cgi/challenge-platform/*"
      ],
      "js": [
        "assets/066bct.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://nopecha.com/setup"
      ],
      "js": [
        "assets/5q203z.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "*://nopecha.com/*"
      ],
      "js": [
        "assets/drr23z.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://nopecha.com/demo/funcaptcha",
        "*://nopecha.com/captcha/funcaptcha"
      ],
      "js": [
        "assets/ea3jwo.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/loomo6.js"
      ],
      "run_at": "document_end",
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "icons": {
    "16": "/icon/16.png",
    "24": "/icon/24.png",
    "32": "/icon/32.png",
    "48": "/icon/48.png",
    "64": "/icon/64.png",
    "128": "/icon/128.png"
  },
  "manifest_version": 2,
  "background": {
    "scripts": [
      "assets/tvvkm8.js"
    ]
  },
  "browser_action": {
    "default_title": "NopeCHA: CAPTCHA Solver",
    "default_popup": "assets/1pmjta.html",
    "default_icon": {
      "16": "/icon/16.png",
      "24": "/icon/24.png",
      "32": "/icon/32.png",
      "48": "/icon/48.png",
      "64": "/icon/64.png",
      "128": "/icon/128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{2f67aecb-5dac-4f76-9378-0ac4f2bedc9c}",
      "strict_min_version": "100.0"
    }
  }
}